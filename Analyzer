<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Dota 2 · Анализ предмета на герое</title>
<style>
  :root {
    --bg: #0f1115;
    --card: #181b22;
    --card2: #1f232c;
    --border: #2a2f3a;
    --text: #e8eaed;
    --muted: #9aa0a6;
    --accent: #6aa9ff;
    --win: #3ddc84;
    --lose: #ff6b6b;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    padding: 24px 16px 60px;
  }
  .container { max-width: 980px; margin: 0 auto; }
  h1 { font-size: 1.6rem; font-weight: 700; margin-bottom: 8px; }
  .subtitle { color: var(--muted); font-size: 0.95rem; margin-bottom: 28px; }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
    margin-bottom: 22px;
  }
  .grid { display: grid; gap: 14px; }
  @media (min-width: 680px) {
    .grid-3 { grid-template-columns: 1fr 1fr 1fr; align-items: end; }
  }
  label { display: block; font-size: 0.82rem; color: var(--muted); margin-bottom: 6px; text-transform: uppercase; letter-spacing: 0.04em; }
  input, select {
    width: 100%;
    padding: 11px 13px;
    border-radius: 9px;
    border: 1px solid var(--border);
    background: var(--card2);
    color: var(--text);
    font-size: 0.95rem;
    outline: none;
  }
  input:focus, select:focus { border-color: var(--accent); }
  button {
    padding: 12px 22px;
    border: none;
    border-radius: 9px;
    background: var(--accent);
    color: #0b1220;
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    transition: opacity 0.15s;
    white-space: nowrap;
  }
  button:hover { opacity: 0.88; }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  .status { font-size: 0.9rem; color: var(--muted); margin-top: 12px; min-height: 1.2em; }
  .status.error { color: var(--lose); }

  /* Блок винрейта */
  .winrate-block {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 8px;
  }
  .winrate-number {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.03em;
  }
  .winrate-label {
    font-size: 1.15rem;
    font-weight: 700;
    padding: 7px 14px;
    border-radius: 8px;
    background: rgba(255,255,255,0.04);
  }
  .winrate-red { color: var(--lose); }
  .winrate-green { color: var(--win); }
  .winrate-label.winrate-red { border: 1px solid rgba(255,107,107,0.35); }
  .winrate-label.winrate-green { border: 1px solid rgba(61,220,132,0.35); }

  .avg-timing {
    font-size: 0.95rem;
    color: var(--muted);
    margin-top: 4px;
    margin-bottom: 20px;
  }
  .avg-timing strong { color: var(--text); }

  /* Список игр */
  .match-list { display: flex; flex-direction: column; gap: 8px; }
  .match-row {
    display: grid;
    grid-template-columns: 1fr auto auto auto;
    gap: 12px;
    align-items: center;
    padding: 12px 14px;
    background: var(--card2);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 0.92rem;
  }
  @media (max-width: 620px) {
    .match-row { grid-template-columns: 1fr 1fr; row-gap: 6px; font-size: 0.86rem; }
  }
  .match-result { font-weight: 700; }
  .match-result.win { color: var(--win); }
  .match-result.lose { color: var(--lose); }
  .match-kda { color: var(--muted); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .match-timing { font-weight: 600; font-variant-numeric: tabular-nums; color: var(--accent); white-space: nowrap; }
  .match-date { color: var(--muted); font-size: 0.82rem; white-space: nowrap; }
  .empty { color: var(--muted); padding: 18px 0; text-align: center; }
</style>
</head>
<body>
<div class="container">
  <h1>Анализ предмета на герое</h1>
  <p class="subtitle">Введите Steam ID, выберите предмет и героя — сайт найдёт все ваши игры с этим предметом на этом герое, посчитает винрейт и средний тайминг покупки.</p>

  <div class="card">
    <div class="grid grid-3">
      <div>
        <label for="steamInput">Steam ID / ссылка на профиль</label>
        <input id="steamInput" type="text" placeholder="76561198000000000 или 12345678" />
      </div>
      <div>
        <label for="itemSelect">Предмет</label>
        <select id="itemSelect"><option value="">Загрузка…</option></select>
      </div>
      <div>
        <label for="heroSelect">Герой</label>
        <select id="heroSelect"><option value="">Загрузка…</option></select>
      </div>
    </div>
    <div style="margin-top:16px;">
      <button id="searchBtn">Найти игры</button>
    </div>
    <div id="status" class="status"></div>
  </div>

  <div id="resultCard" class="card" style="display:none;">
    <div id="resultContent"></div>
  </div>
</div>

<script>
/* ============================================================
   КОНСТАНТЫ И СОСТОЯНИЕ
   ============================================================ */
const OPEN_DOTA = 'https://api.opendota.com/api';
const STEAM_CDN = 'https://cdn.cloudflare.steamstatic.com';

let constants = { heroes: [], items: [] };
let heroMap = {};   // id -> localized_name
let itemMap = {};   // id -> dname

/* ============================================================
   УТИЛИТЫ
   ============================================================ */
function $(id) { return document.getElementById(id); }

function setStatus(msg, isError = false) {
  const el = $('status');
  el.textContent = msg;
  el.classList.toggle('error', isError);
}

function formatTime(seconds) {
  if (seconds == null || isNaN(seconds)) return '—';
  const m = Math.floor(seconds / 60);
  const s = Math.floor(seconds % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
}

function formatDate(unixSeconds) {
  if (!unixSeconds) return '—';
  const d = new Date(unixSeconds * 1000);
  return d.toLocaleDateString('ru-RU', { day: '2-digit', month: '2-digit', year: '2-digit' });
}

/* ============================================================
   STEAM ID
   ============================================================ */
function extractAccountId(input) {
  const raw = input.trim();
  if (!raw) return null;

  // Ссылка на профиль Steam
  const urlMatch = raw.match(/steamcommunity\.com\/profiles\/(\d+)/);
  if (urlMatch) return steam64ToAccountId(urlMatch[1]);

  // Только цифры
  const digits = raw.replace(/\D/g, '');
  if (!digits) return null;

  if (digits.length === 17) return steam64ToAccountId(digits);          // SteamID64
  if (digits.length <= 10) return parseInt(digits, 10);                 // account_id / friend code
  return null;
}

function steam64ToAccountId(steam64) {
  const base = 76561197960265728n;
  try {
    return Number(BigInt(steam64) - base);
  } catch {
    return null;
  }
}

/* ============================================================
   ЗАГРУЗКА КОНСТАНТ (герои + предметы)
   ============================================================ */
async function loadConstants() {
  try {
    const [heroesRes, itemsRes] = await Promise.all([
      fetch(`${OPEN_DOTA}/constants/heroes`),
      fetch(`${OPEN_DOTA}/constants/items`)
    ]);

    const heroesObj = await heroesRes.json();
    const itemsObj = await itemsRes.json();

    // heroes: { "1": { id:1, localized_name:"Anti-Mage", ... }, ... }
    constants.heroes = Object.values(heroesObj)
      .filter(h => h.id && h.localized_name)
      .sort((a, b) => a.localized_name.localeCompare(b.localized_name));

    // items: { "1": { id:1, dname:"Blink Dagger", ... }, ... }
    constants.items = Object.values(itemsObj)
      .filter(i => i.id && i.dname && i.dname !== 'Recipe')
      .sort((a, b) => a.dname.localeCompare(b.dname));

    constants.heroes.forEach(h => { heroMap[h.id] = h.localized_name; });
    constants.items.forEach(i => { itemMap[i.id] = i.dname; });

    fillSelect($('heroSelect'), constants.heroes, h => `${h.localized_name}`);
    fillSelect($('itemSelect'), constants.items, i => i.dname);

  } catch (err) {
    console.error(err);
    setStatus('Не удалось загрузить справочники Dota 2. Проверьте интернет и обновите страницу.', true);
  }
}

function fillSelect(selectEl, list, labelFn) {
  selectEl.innerHTML = '<option value="">— выберите —</option>' +
    list.map(obj => `<option value="${obj.id}">${labelFn(obj)}</option>`).join('');
}

/* ============================================================
   ПОИСК МАТЧЕЙ
   ============================================================ */
async function findMatches(accountId, heroId, itemId) {
  // 1. Получаем список матчей игрока (до 500 последних — достаточно для анализа)
  const matchesRes = await fetch(`${OPEN_DOTA}/players/${accountId}/matches?limit=500`);
  if (!matchesRes.ok) {
    throw new Error(`OpenDota вернул ${matchesRes.status}. Проверьте Steam ID и попробуйте позже.`);
  }
  const recentMatches = await matchesRes.json();
  if (!Array.isArray(recentMatches) || recentMatches.length === 0) {
    throw new Error('У этого игрока не найдено матчей (или профиль закрыт).');
  }

  // 2. Оставляем только матчи на выбранном герое
  const heroMatches = recentMatches.filter(m => m.hero_id === heroId);
  if (heroMatches.length === 0) {
    return { matches: [], total: 0, wins: 0, winrate: 0, avgTiming: null };
  }

  // 3. Для каждого матча на герое запрашиваем детали (purchase_log)
  const detailedMatches = [];
  const BATCH_SIZE = 8; // ограничиваем параллелизм, чтобы не ловить rate limit

  for (let i = 0; i < heroMatches.length; i += BATCH_SIZE) {
    const batch = heroMatches.slice(i, i + BATCH_SIZE);
    const details = await Promise.all(
      batch.map(m => fetchMatchDetail(m.match_id).catch(() => null))
    );
    detailedMatches.push(...details.filter(Boolean));
    // Небольшая пауза между батчами
    if (i + BATCH_SIZE < heroMatches.length) await sleep(250);
  }

  // 4. Фильтруем матчи, где в purchase_log есть нужный предмет
  const result = [];

  for (const detail of detailedMatches) {
    const player = detail.players.find(p => p.account_id === accountId);
    if (!player) continue;

    const purchase = (player.purchase_log || []).find(p => p.item_id === itemId);
    if (!purchase) continue;

    // Время покупки: если предмет покупался несколько раз — берём первую покупку
    const timingSeconds = purchase.time;

    const isWin = player.isRadiant ? detail.radiant_win : !detail.radiant_win;

    result.push({
      matchId: detail.match_id,
      win: isWin,
      kills: player.kills ?? 0,
      deaths: player.deaths ?? 0,
      assists: player.assists ?? 0,
      timing: timingSeconds,
      date: detail.start_time
    });
  }

  // Сортируем: новые матчи сверху
  result.sort((a, b) => (b.date || 0) - (a.date || 0));

  const total = result.length;
  const wins = result.filter(m => m.win).length;
  const winrate = total > 0 ? (wins / total) * 100 : 0;
  const avgTiming = total > 0
    ? Math.round(result.reduce((sum, m) => sum + m.timing, 0) / total)
    : null;

  return { matches: result, total, wins, winrate, avgTiming };
}

async function fetchMatchDetail(matchId) {
  const res = await fetch(`${OPEN_DOTA}/matches/${matchId}`);
  if (!res.ok) return null;
  return res.json();
}

function sleep(ms) { return new Promise(r => setTimeout(r, ms)); }

/* ============================================================
   ОТРИСОВКА РЕЗУЛЬТАТА
   ============================================================ */
function renderResult(data, heroId, itemId) {
  const card = $('resultCard');
  const box = $('resultContent');
  card.style.display = 'block';

  const heroName = heroMap[heroId] || 'герой';
  const itemName = itemMap[itemId] || 'предмет';

  if (data.total === 0) {
    box.innerHTML = `
      <div class="empty">
        Не найдено ни одной игры на герое <strong>${heroName}</strong>, где был куплен предмет <strong>${itemName}</strong>.<br>
        Попробуйте другого героя, другой предмет или увеличьте глубину истории (сейчас анализируются последние 500 матчей).
      </div>`;
    return;
  }

  // Винрейт
  const winrateValue = data.winrate;
  const isLow = winrateValue < 50;
  const colorClass = isLow ? 'winrate-red' : 'winrate-green';
  const labelText = isLow ? 'Скрытый пулл' : 'Рабочий билд';

  // Строки матчей
  const rows = data.matches.map(m => {
    const resultClass = m.win ? 'win' : 'lose';
    const resultText = m.win ? 'Победа' : 'Поражение';
    return `
      <div class="match-row">
        <div>
          <span class="match-result ${resultClass}">${resultText}</span>
          <span class="match-date"> · ${formatDate(m.date)}</span>
        </div>
        <div class="match-kda">${m.kills} / ${m.deaths} / ${m.assists}</div>
        <div class="match-timing">${formatTime(m.timing)}</div>
        <div style="text-align:right;color:var(--muted);font-size:0.8rem;">#${m.matchId}</div>
      </div>`;
  }).join('');

  box.innerHTML = `
    <div class="winrate-block">
      <div class="winrate-number ${colorClass}">${winrateValue.toFixed(1)}%</div>
      <div class="winrate-label ${colorClass}">${labelText}</div>
    </div>
    <div class="avg-timing">
      Средний тайминг покупки <strong>${itemName}</strong> на <strong>${heroName}</strong>:
      <strong>${formatTime(data.avgTiming)}</strong>
      <span style="color:var(--muted);">(${data.wins} побед из ${data.total} игр)</span>
    </div>
    <div class="match-list">${rows}</div>
  `;
}

/* ============================================================
   ОБРАБОТЧИК КНОПКИ
   ============================================================ */
async function onSearch() {
  const steamRaw = $('steamInput').value;
  const heroId = parseInt($('heroSelect').value, 10);
  const itemId = parseInt($('itemSelect').value, 10);

  if (!steamRaw.trim()) { setStatus('Введите Steam ID или ссылку на профиль.', true); return; }
  if (!heroId) { setStatus('Выберите героя.', true); return; }
  if (!itemId) { setStatus('Выберите предмет.', true); return; }

  const accountId = extractAccountId(steamRaw);
  if (!accountId) {
    setStatus('Не удалось распознать Steam ID. Введите SteamID64 (17 цифр), account_id или ссылку на профиль.', true);
    return;
  }

  const btn = $('searchBtn');
  btn.disabled = true;
  setStatus('Ищем матчи… Это может занять до 30–60 секунд (в зависимости от количества игр на герое).');

  try {
    const data = await findMatches(accountId, heroId, itemId);
    renderResult(data, heroId, itemId);
    setStatus(`Готово. Найдено ${data.total} игр.`);
  } catch (err) {
    console.error(err);
    setStatus(err.message || 'Произошла ошибка при запросе к OpenDota.', true);
  } finally {
    btn.disabled = false;
  }
}

/* ============================================================
   СТАРТ
   ============================================================ */
$('searchBtn').addEventListener('click', onSearch);
loadConstants();
</script>
</body>
</html>
